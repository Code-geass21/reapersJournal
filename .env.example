# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=reapers_journal

# Application Security
JWT_SECRET=your_super_secret_jwt_key

# Localization & Scheduling
TZ=Asia/Kolkata
